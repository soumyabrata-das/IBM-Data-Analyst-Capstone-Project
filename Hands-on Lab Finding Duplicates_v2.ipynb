# df = pd.read_csv("https://cf-courses-data.s3.us.cloud-object-storage.appdomain.cloud/n01PQ9pSmiRX6520flujwQ/survey-data.csv")
df = pd.read_csv(file_path)








# Count duplicate rows
duplicate_count = df.duplicated().sum()

print("Number of duplicate rows:", duplicate_count)

# Display the first few duplicate rows
df[df.duplicated()].head()





# Selected columns for response pattern analysis
pattern_cols = ['MainBranch', 'Employment', 'RemoteWork']

# Find duplicate response patterns
duplicate_patterns = df[df.duplicated(subset=pattern_cols, keep=False)]

# Count rows that share the same response pattern
print("Rows with duplicate response patterns:", len(duplicate_patterns))

# Display first few examples
duplicate_patterns[pattern_cols].head()





import pandas as pd
import matplotlib.pyplot as plt

# Create grouped response patterns
pattern_counts = (
    df.groupby(['Country', 'MainBranch', 'Employment', 'RemoteWork'])
      .size()
      .reset_index(name='Count')
)

# Display the top 10 most common patterns
top_patterns = pattern_counts.sort_values('Count', ascending=False).head(10)

# Plot
plt.figure(figsize=(12,6))
plt.bar(range(len(top_patterns)), top_patterns['Count'])
plt.xticks(
    range(len(top_patterns)),
    top_patterns['Country'],
    rotation=45,
    ha='right'
)
plt.title('Top Shared Response Patterns by Country')
plt.xlabel('Country')
plt.ylabel('Number of Respondents')
plt.tight_layout()
plt.show()






























